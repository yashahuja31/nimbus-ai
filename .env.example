# Copy this to .env in the project root (docker-compose reads it for the
# backend and worker services).

# --- Auth: Clerk verifies tokens issued by your Clerk instance ---
# Clerk Dashboard -> Configure -> API Keys -> Show JWKS URL
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional -- only needed if you want issuer validation too.
CLERK_ISSUER=

# --- AI provider (Gemini, per the product spec) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-pro

# --- AWS: the customer account Nimbus operates on ---
# Use an IAM user/role scoped to exactly what Phase 1 needs (s3:CreateBucket,
# s3:PutBucketVersioning, s3:PutEncryptionConfiguration) -- not an admin key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Safety ---
# Keep this true until you've reviewed the executor code in
# backend/app/executor and are ready for Nimbus to make real AWS calls.
DRY_RUN=true

# --- Scaling knobs (sane defaults, override if needed) ---
CHAT_RATE_LIMIT=10/minute
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
# Comma-separated allowed frontend origins in production, e.g.
# https://app.nimbus.ai -- leave as * for local dev.
CORS_ORIGINS=*
