# Copy this to .env in the project root (docker-compose reads it for the
# backend and worker services).

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- AI provider (Gemini, per the product spec) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-pro

# --- AWS: the customer account Nimbus operates on ---
# Use an IAM user/role scoped to exactly what Phase 1 needs (s3:CreateBucket,
# s3:PutBucketVersioning, s3:PutBucketEncryption) -- not an admin key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Safety ---
# Keep this true until you've reviewed the executor code in
# backend/app/executor and are ready for Nimbus to make real AWS calls.
DRY_RUN=true
