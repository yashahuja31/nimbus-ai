# Copy this to frontend/.env.local for local dev (docker-compose's frontend
# build picks it up automatically since it's inside the build context).

# Clerk Dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the frontend reaches the backend. Leave as-is for docker-compose;
# set to your deployed backend URL in production (see docs/DEPLOYMENT.md).
NEXT_PUBLIC_API_BASE=http://localhost:8000
